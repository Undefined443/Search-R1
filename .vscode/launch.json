{
  "version": "0.2.0",
  "configurations": [
    {
      // 启动检索服务器
      "name": "retrieval_server",
      "cwd": "${workspaceFolder}",
      "type": "debugpy",
      "request": "launch",
      "python": "${userHome}/.local/opt/miniforge3/envs/retriever/bin/python",
      "program": "search_r1/search/retrieval_server.py",
      "args": [
        "--index_path=data/corpus/e5_Flat.index",
        "--corpus_path=data/corpus/wiki-18.jsonl",
        "--topk=3",
        "--retriever_name=e5",
        "--retriever_model=intfloat/e5-base-v2",
        "--faiss_gpu"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "0",
        "OMP_NUM_THREADS": "12",
        "PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "5.0",
        "https_proxy": "http://127.0.0.1:6152"
      }
    },
    {
      // 训练 PPO（GSM8K）
      "name": "main_ppo",
      "cwd": "${workspaceFolder}",
      "type": "debugpy",
      "request": "launch",
      "python": "${userHome}/.local/opt/miniforge3/envs/searchr1/bin/python",
      "module": "verl.trainer.main_ppo",
      "args": [
        "data.train_files=data/gsm8k_search/train.parquet",  // NOTE: 修改数据集
        "data.val_files=data/gsm8k_search/test.parquet",
        "data.train_data_num=null",
        "data.val_data_num=null",
        "data.train_batch_size=512",  // NOTE: 修改 train batch size
        "data.val_batch_size=256",
        "data.max_prompt_length=4096",
        "data.max_response_length=500",
        "data.max_start_length=2048",
        "data.max_obs_length=500",
        "data.shuffle_train_dataloader=True",
        "algorithm.adv_estimator=gae",
        "actor_rollout_ref.model.path=Qwen/Qwen3-4B-Base",  // NOTE: 修改模型
        "actor_rollout_ref.actor.optim.lr=1e-6",
        "actor_rollout_ref.model.enable_gradient_checkpointing=true",
        "actor_rollout_ref.model.use_remove_padding=True",
        "actor_rollout_ref.actor.optim.lr_warmup_steps_ratio=0.285",
        "actor_rollout_ref.actor.ppo_mini_batch_size=256",  // NOTE: 修改 mini batch size
        "actor_rollout_ref.actor.ppo_micro_batch_size=64",  // NOTE: 修改 micro batch size
        "actor_rollout_ref.actor.fsdp_config.param_offload=true",
        "actor_rollout_ref.actor.fsdp_config.grad_offload=true",
        "actor_rollout_ref.actor.fsdp_config.optimizer_offload=true",
        "actor_rollout_ref.rollout.log_prob_micro_batch_size=128",  // NOTE: 修改 log prob micro batch size
        "actor_rollout_ref.rollout.tensor_model_parallel_size=1",
        "actor_rollout_ref.rollout.name=vllm",
        "actor_rollout_ref.rollout.gpu_memory_utilization=0.6",
        "actor_rollout_ref.ref.log_prob_micro_batch_size=128",
        "actor_rollout_ref.ref.fsdp_config.param_offload=True",
        "actor_rollout_ref.rollout.n_agent=1",
        "actor_rollout_ref.rollout.temperature=1",
        "actor_rollout_ref.actor.state_masking=true",
        "critic.optim.lr=1e-5",
        "critic.model.use_remove_padding=True",
        "critic.optim.lr_warmup_steps_ratio=0.015",
        "critic.model.path=Qwen/Qwen3-4B-Base",
        "critic.model.enable_gradient_checkpointing=true",
        "critic.ppo_micro_batch_size=8",  // NOTE: 修改 critic micro batch size
        "critic.model.fsdp_config.param_offload=true",
        "critic.model.fsdp_config.grad_offload=true",
        "critic.model.fsdp_config.optimizer_offload=true",
        "algorithm.kl_ctrl.kl_coef=0.001",
        "algorithm.no_think_rl=false",
        "trainer.critic_warmup=0",
        "trainer.logger=['wandb']",
        "+trainer.val_only=false",
        "+trainer.val_before_train=true",
        "trainer.default_hdfs_dir=null",
        "trainer.n_gpus_per_node=8",  // NOTE: 修改 GPU 数
        "trainer.nnodes=1",
        "trainer.save_freq=100",
        "trainer.test_freq=50",
        "trainer.project_name=Search-R1",
        "trainer.experiment_name=nq-search-r1-ppo-qwen3-4b-base-em",
        "trainer.total_epochs=15",
        "trainer.total_training_steps=1005",
        "trainer.default_hdfs_dir=null",
        "trainer.default_local_dir=verl_checkpoints/nq-search-r1-ppo-qwen3-4b-base-em",
        "max_turns=2",
        "retriever.url=\"http://127.0.0.1:8000/retrieve\"",  // NOTE: 修改 retriever url
        "retriever.topk=3"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "VLLM_ATTENTION_BACKEND": "XFORMERS",
        "WANDB_API_KEY": "42db7139cb941c61b4eaffac7af756f44f5ebd2b",
        "CUDA_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",  // NOTE: 修改 CUDA_VISIBLE_DEVICES
        "HYDRA_FULL_ERROR": "1",  // NOTE: 启用完整错误信息
        "OMP_NUM_THREADS": "12",
        "PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "5.0",
        "https_proxy": "http://127.0.0.1:6152",
        "no_proxy": "127.0.0.1"
      }
    }
  ]
}
